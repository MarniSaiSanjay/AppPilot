# AppPilot work environment template.
# Copy this file to .env, replace every placeholder, and keep .env untracked.
# AppPilot uses Microsoft Entra authentication for work Azure OpenAI.

# Required work Azure OpenAI configuration.
APPPILOT_MODEL=gpt-4.1-mini
APPPILOT_MODEL_BASE_URL=https://your-work-resource.openai.azure.com/openai/v1

# Required Deeplink APK trust configuration.
APPPILOT_EXPECTED_PACKAGE_ID=com.example.apppilot
APPPILOT_TRUSTED_CERT_SHA256=replace-with-the-trusted-64-hex-sha256-fingerprint

# Required for the current Deeplink workbook profiles.
APPPILOT_USERNAME_ENTRA_PREMIUM=replace-with-work-entra-premium-username
APPPILOT_PASSWORD_ENTRA_PREMIUM=replace-with-work-entra-premium-password
APPPILOT_USERNAME_MSA_PREMIUM=replace-with-work-msa-premium-username
APPPILOT_PASSWORD_MSA_PREMIUM=replace-with-work-msa-premium-password

# Optional work email report relay.
# APPPILOT_EMAIL_API_URL=https://your-work-relay.example.com/send-report
# APPPILOT_EMAIL_API_KEY=replace-with-work-email-relay-credential

# Optional work telemetry relay.
# APPPILOT_TELEMETRY_URL=https://your-work-relay.example.com/telemetry
# APPPILOT_TELEMETRY_API_KEY=replace-with-work-telemetry-relay-credential

# Optional runtime tuning.
# APPPILOT_MAX_ACTIONS=30
# APPPILOT_MAX_STUCK_ACTIONS=5
