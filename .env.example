# AppPilot user environment template.
# This file is only for non-interactive Deeplink test-account credentials.
# Interactive runs prompt for missing workbook credentials and keep them in
# memory for that run. Keep .env untracked.

APPPILOT_USERNAME_ENTRA_PREMIUM=replace-with-entra-premium-test-username
APPPILOT_PASSWORD_ENTRA_PREMIUM=replace-with-entra-premium-test-password
APPPILOT_USERNAME_MSA_PREMIUM=replace-with-msa-premium-test-username
APPPILOT_PASSWORD_MSA_PREMIUM=replace-with-msa-premium-test-password
